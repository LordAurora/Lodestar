# Copy to .env (in the repo root or backend/) and adjust. All values are optional.

# Where SQLite databases, settings.json and fastembed models are stored.
# LODESTAR_DATA_DIR=C:/path/to/lodestar-data   (default: backend/data)

# Address of the FastAPI server. Keep it on loopback: Lodestar is single-user and local.
LODESTAR_HOST=127.0.0.1
LODESTAR_PORT=8000

# Embedding model:
#   auto                                   Foundry Local's qwen3-embedding-0.6b if downloaded, else fastembed
#   foundry | foundry:<alias>              Foundry Local only (downloads the model if needed)
#   fastembed | fastembed:<hf-model-name>  fastembed only, e.g. fastembed:BAAI/bge-small-en-v1.5
# Changing the model re-indexes each repository on its next index run.
LODESTAR_EMBEDDING_MODEL=auto
LODESTAR_EMBEDDING_BATCH_SIZE=32

# Chat model used until one is picked in Settings (any Foundry Local alias).
LODESTAR_DEFAULT_CHAT_MODEL=qwen2.5-coder-1.5b

# Never let the embedding library reach Hugging Face at runtime (models come from `make setup`).
# Where models run: auto (GPU if its execution provider is installed), gpu, cpu.
LODESTAR_DEVICE=auto

LODESTAR_OFFLINE=true

# Insights.
# Comment tags the tech debt board collects, and how alike two comments must be to share a topic.
# LODESTAR_DEBT_TAGS=TODO,FIXME,HACK,XXX,BUG,NOTE
# LODESTAR_DEBT_TOPIC_THRESHOLD=0.6
# Duplicate finder: default similarity (0.80 to 1.0) and the smallest function considered (lines).
# LODESTAR_DUPLICATE_MIN_SIMILARITY=0.90
# LODESTAR_DUPLICATE_MIN_LINES=5
# Python docstring style for suggestions: google, numpy or rest.
# LODESTAR_DOCSTRING_STYLE=google

# Bring your own chat model: any OpenAI-compatible server you run (Ollama, LM Studio,
# llama.cpp, vLLM, a company gateway). Only the chat model moves; embeddings stay local.
# A server on 127.0.0.1 keeps everything local. A remote host receives questions and code snippets.
# LODESTAR_LLM_PROVIDER=openai
# LODESTAR_LLM_BASE_URL=http://127.0.0.1:11434/v1
# LODESTAR_LLM_MODEL=llama3.3:70b
# LODESTAR_LLM_API_KEY=
# LODESTAR_LLM_TIMEOUT=120
# Extra hosts the network guard may reach (comma separated). The LLM host is allowed automatically.
# LODESTAR_ALLOWED_HOSTS=

# Block every outbound socket connection from the backend that is not to localhost.
LODESTAR_BLOCK_EXTERNAL_NETWORK=true

# Files larger than this (bytes) are not indexed.
LODESTAR_MAX_FILE_BYTES=1000000
